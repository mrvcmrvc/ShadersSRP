    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 clipPos = float4(uv * 2 - 1, depth, 1);\nfloat4 viewPos = mul(unity_CameraInvProjection, clipPos);\nworldPos = viewPos.xyz / viewPos.w;"
}

